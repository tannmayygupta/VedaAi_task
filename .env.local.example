# Google Gemini API key (https://aistudio.google.com/apikey) — used server-side only.
GEMINI_API_KEY=

# Vercel Blob — needed starting Phase 1 for direct client-to-Blob file uploads
# (see docs/DECISIONS.md "Upload architecture correction").
# Create a Blob store via the Vercel dashboard (Storage tab) or `vercel blob store add`,
# then copy its token here for local development.
BLOB_READ_WRITE_TOKEN=
